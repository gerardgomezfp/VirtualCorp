{# Plantilla unificada per generar fitxers de zona directa (A) i inversa (PTR) a BIND9 #}
$TTL {{ bind_zone_default_ttl }}
{% if item.records is defined and item.records | selectattr('ptr', 'defined') | list | length > 0 %}
{# Branca per a zones inverses (*.in-addr.arpa): ressol IPv4 -> nom canònic (FQDN) #}
@   IN  SOA ns1.delegacion8.lan. {{ bind_zone_admin_email }} (
        {{ bind_zone_serial }} ; Serial
        {{ bind_zone_refresh }}      ; Refresh
        {{ bind_zone_retry }}       ; Retry
        {{ bind_zone_expire }}    ; Expire
        {{ bind_zone_negative_ttl }} )     ; Negative Cache TTL

; Registre NS autoritatiu per a la zona inversa de la Delegació 8
@   IN  NS  ns1.delegacion8.lan.

; Registres PTR (últim octet dins del bloc -> FQDN acabat en punt)
{% for rec in item.records %}
{{ "%-14s" | format(rec.ptr) }} IN  PTR  {{ rec.fqdn }}
{% endfor %}
{% else %}
{# Branca per a zones directes (*.delegacion8.lan / delegacion8.com): ressol nom -> IPv4 #}
@   IN  SOA {{ bind_zone_ns_name }}.{{ item.name }}. {{ bind_zone_admin_email }} (
        {{ bind_zone_serial }} ; Serial
        {{ bind_zone_refresh }}      ; Refresh
        {{ bind_zone_retry }}       ; Retry
        {{ bind_zone_expire }}    ; Expire
        {{ bind_zone_negative_ttl }} )     ; Negative Cache TTL

; Registre NS de la zona directa
@   IN  NS  {{ bind_zone_ns_name }}.{{ item.name }}.

; Registres A definits per a {{ item.name }}
{% for rec in item.records %}
{{ "%-14s" | format(rec.name) }} IN  {{ "%-4s" | format(rec.type) }} {{ rec.value }}
{% endfor %}
{% endif %}